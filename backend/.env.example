# Local development only. Copy to .env (ignored by Git).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=loyalty_dev
DB_USERNAME=loyalty_dev
DB_PASSWORD=local_dev_only
# Production requires DB_URL, DB_USERNAME and DB_PASSWORD from secret storage.
# DB_URL=jdbc:postgresql://database.example:5432/loyalty
# DB_SSL_MODE=verify-full
# Optional separate production migration account: set all three together.
# DB_MIGRATION_URL=jdbc:postgresql://database.example:5432/loyalty
# DB_MIGRATION_USERNAME=loyalty_migrator
# DB_MIGRATION_PASSWORD=replace_in_secret_storage

# Exact comma-separated browser origins; no trailing slash or wildcards.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production: supply explicit frontend origin(s) in the deployment environment.
# Leaving it unset in prod rejects cross-origin API requests; same-origin still works.

# Independent CSRF-valid login attempts / 15 minutes / IP (range 1-1000).
# Failed account/IP attempts remain fixed at 10 / 15 minutes.
LOGIN_IP_ATTEMPT_LIMIT=50

# Server-owned positive integer award per qualifying visit (default 100).
POINTS_PER_VISIT=100

# QR signing is required in ALL profiles. Generate a fresh local-only key:
# openssl rand -base64 32
QR_ISSUER=loyalty-local
QR_AUDIENCE=loyalty-local-identity
QR_ACTIVE_KEY_ID=local-v1
# Paste the generated Base64 key below in your ignored .env; never commit it.
QR_SIGNING_KEY_BASE64=
# Optional old verification keys as JSON; exclude QR_ACTIVE_KEY_ID.
# Set through a secret store in production. Never copy real secrets into this example.
# QR_VERIFICATION_KEYS='{"previous-key-id":"base64-previous-key-from-secret-storage"}'

# Per-process failed-confirmation budgets / minute (1-1000). Successful results release their reservations.
QR_CONFIRM_FAILURE_LIMIT=60
QR_CONFIRM_IP_FAILURE_LIMIT=240

# Server-owned game life defaults; never use Vite/browser configuration for these.
GAME_MAX_LIVES=3
GAME_LIFE_RECHARGE_INTERVAL=PT2H

# Server-owned session settings; snapshotted into each new run.
GAME_SESSION_LIFETIME=PT15M
GAME_ENGINE_VERSION=v1

# Per-process score submission budgets / minute (range 1-1000), including retries.
GAME_SCORE_CUSTOMER_LIMIT=60
GAME_SCORE_IP_LIMIT=240

# Separate 32-byte Base64 secret for opaque authenticated leaderboard cursors.
# Generate with openssl rand -base64 32; share across replicas/restarts in production.
# Blank uses a per-process random key (old cursors become invalid after restart).
LEADERBOARD_CURSOR_KEY_BASE64=
